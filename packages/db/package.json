{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/preflight.ts migrate && drizzle-kit migrate && tsx scripts/verify.ts",
    "db:verify": "tsx scripts/verify.ts",
    "db:push": "tsx scripts/preflight.ts push && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "topup-demo-account": "tsx scripts/topup-demo-account.ts",
    "grant-credits": "tsx scripts/grant-credits.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "@neondatabase/serverless": "^1.1.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10"
  }
}
