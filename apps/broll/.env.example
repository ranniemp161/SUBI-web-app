# Clerk — the SAME instance as rough-cut and wallet. B-Roll joins the existing
# multi-domain SSO set so a user signed in on Ruff Cut is signed in here, and
# can deep-link to Wallet to top up and come back still authenticated.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Shared Neon database (@repo/db). Same tables as rough-cut and wallet.
DATABASE_URL=

# Cross-app URLs. Read ONLY through src/lib/env.ts, never process.env directly.
# Both throw at import time in a production build if unset.
NEXT_PUBLIC_ROUGH_CUT_URL=http://localhost:3000
NEXT_PUBLIC_WALLET_URL=http://localhost:3001
