# Clerk — the SAME instance as rough-cut and wallet. B-Roll joins the existing
# multi-domain SSO set so a user signed in on Ruff Cut is signed in here, and
# can deep-link to Wallet to top up and come back still authenticated.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Shared Neon database (@repo/db). Same tables as rough-cut and wallet.
DATABASE_URL=

# Cross-app URLs. Read ONLY through src/lib/env.ts, never process.env directly.
# Both throw at import time in a production build if unset.
NEXT_PUBLIC_ROUGH_CUT_URL=http://localhost:3000
NEXT_PUBLIC_WALLET_URL=http://localhost:3001

# Gemini — character generation (images) and scene planning (text). Nothing in
# this app reads it yet; Phase 2 is the first code that does. Already listed in
# turbo.json's build env array, so a Vercel build can see it.
#
# In development this is your own key and the spend is real: at the Pro image
# tier a six-emotion character set is roughly $0.84 of live API usage. Pin exact
# model IDs, never the -latest aliases — see the high level design's rationale
# §3, where a "listed" model returned 404 as retired.
GEMINI_API_KEY=

# The image model the character pipeline calls. Optional: falls back to
# DEFAULT_IMAGE_MODEL in src/lib/character-prompt.ts. It is overridable so a
# retired model id is a Vercel env change rather than a code change.
# BROLL_IMAGE_MODEL=gemini-3-pro-image

# Vercel Blob — where the six generated character PNGs are stored. REQUIRED for
# character generation: without it the Generate button answers 503 "Storage
# isn't configured on this server."
#
# The store must be created with PRIVATE access, and that cannot be changed
# afterwards. Every read is a signed URL (src/lib/storage.ts); a public store
# would hand out permanent links instead. This is a DIFFERENT store from
# rough-cut's, whose store is public and holds ephemeral audio — do not paste
# rough-cut's token here.
#
# Create the store in the Vercel dashboard, then copy the token it provisions
# (`vercel env pull` is the easy way once a project is connected). Already in
# turbo.json's build env array.
#
# This is the ONLY blob variable you need. Spec broll/0004 also lists
# BLOB_WEBHOOK_PUBLIC_KEY, but Vercel provisions no such variable: measured
# 2026-08-11, Ruff Cut has had a store connected for a month and its project
# holds only the token below. The SDK demands a webhook key anyway, so
# src/app/api/blob/upload/route.ts supplies its own inert one and explains why.
# Set BLOB_WEBHOOK_PUBLIC_KEY only if Vercel ever starts issuing one; the route
# prefers it when present.
BLOB_READ_WRITE_TOKEN=

# Prices, all in USD micros (1,000,000 = $1). Optional: each falls back to the
# default in @repo/billing/pricing. Prices are config, not code — these exist so
# the client can reprice without a redeploy. See spec broll/0001 §8.1.
# BROLL_CHARACTER_SET_MICROS=2000000
# BROLL_PLAN_RERUN_MICROS=250000
